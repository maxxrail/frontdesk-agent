# Copy to .env for local development: cp .env.example .env
# Never commit .env. Every variable is prefixed FDA_.

FDA_ENV=local
FDA_LOG_LEVEL=INFO
FDA_DATABASE_URL=postgresql+psycopg://frontdesk:frontdesk@localhost:5432/frontdesk
# Tests use their own database, created automatically and wiped every test.
# FDA_TEST_DATABASE_URL=postgresql+psycopg://frontdesk:frontdesk@localhost:5432/frontdesk_test
# FDA_SKIP_DB_TESTS=1

# Required from Module 1 on. Set a spend limit on the key in the Console
# BEFORE running anything that calls it. Never commit the real key.
FDA_ANTHROPIC_API_KEY=
FDA_LLM_MODEL=claude-haiku-4-5-20251001
# Cheap model for lookup-only agent steps (ADR 0019); empty turns routing off.
FDA_LLM_LOOKUP_MODEL=claude-haiku-5-5
FDA_LLM_TIMEOUT_S=20
# prompts/agent/<version>.md. Changing this or the model runs the eval suite in CI.
FDA_AGENT_PROMPT_VERSION=v3

# Retrieval (ADR 0008). Rerun evals/retrieval.py before changing these.
FDA_RETRIEVAL_MODE=vector
FDA_RETRIEVAL_K=5
FDA_RETRIEVAL_MIN_SIMILARITY=0.12

# SMS channel (Module 4). Without the auth token the webhook refuses all requests.
FDA_TWILIO_ACCOUNT_SID=
FDA_TWILIO_AUTH_TOKEN=
# The public URL Twilio calls (your ngrok host locally). Signatures depend on it.
FDA_PUBLIC_BASE_URL=http://localhost:8000
# twilio sends real texts; console prints them.
FDA_SMS_SENDER=console

# Auth (Module 6). Signs dashboard login tokens; the server will not start
# without it. Generate one (prints nothing if piped straight into .env):
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
FDA_JWT_SECRET=
FDA_JWT_TTL_MINUTES=60

# Error reporting (Module 7). Empty sends nothing. Events are redacted
# before sending: no phone numbers, names, message text or headers.
FDA_SENTRY_DSN=
# Traces (Module 7): an OTLP/HTTP collector. With docker compose, Jaeger:
# FDA_OTEL_ENDPOINT=http://localhost:4318, UI at http://localhost:16686.
FDA_OTEL_ENDPOINT=

# Rate limits (Module 6, ADR 0018). Per phone: texts per window before the
# conversation pauses for a person. Per tenant: model calls per window
# before new messages are deferred.
FDA_RATE_PHONE_MESSAGES=12
FDA_RATE_PHONE_WINDOW_S=600
FDA_RATE_TENANT_MODEL_CALLS=1000
FDA_RATE_TENANT_WINDOW_S=3600

# Background jobs: redis (with the worker) or inline (inside the API process).
FDA_JOB_QUEUE=inline
FDA_REDIS_URL=redis://localhost:6379/0
