# Copy to .env for local development: cp .env.example .env
# Never commit .env. Every variable is prefixed FDA_.

FDA_ENV=local
FDA_LOG_LEVEL=INFO
FDA_DATABASE_URL=postgresql+psycopg://frontdesk:frontdesk@localhost:5432/frontdesk

# Required from Module 1 on. Set a spend limit on the key in the Console
# BEFORE running anything that calls it. Never commit the real key.
FDA_ANTHROPIC_API_KEY=
FDA_LLM_MODEL=claude-haiku-4-5-20251001
FDA_LLM_TIMEOUT_S=20
