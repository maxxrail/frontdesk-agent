# Copy to .env for local development: cp .env.example .env
# Never commit .env. Every variable is prefixed FDA_.

FDA_ENV=local
FDA_LOG_LEVEL=INFO
FDA_DATABASE_URL=postgresql+psycopg://frontdesk:frontdesk@localhost:5432/frontdesk

# Module 1 adds the LLM provider key here. Set a hard spend cap on the key
# in the provider console BEFORE you write any code that calls it.
# FDA_ANTHROPIC_API_KEY=
